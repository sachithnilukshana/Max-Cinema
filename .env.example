# ==============================================================================
# Max Cinema Environment Configuration Template
# Copy this file to `.env` and fill in your actual production/staging values.
# NEVER commit the `.env` file to version control.
# ==============================================================================

# ── TMDB (The Movie Database) ────────────────────────────────────────────────
# Required for fetching movie & series catalog, posters, search, credits, etc.
# Get your free v3 API key at: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_v3_api_key_here

# Optional: v4 Read Access Token (alternative to TMDB_API_KEY)
# TMDB_READ_ACCESS_TOKEN=your_tmdb_v4_read_access_token_here

# ── EmbedMaster Video Streaming (https://embedmaster.com) ───────────────────
# Base embed domain for EmbedMaster iframe player (defaults to https://embedmaster.link)
EMBED_BASE=https://embedmaster.link

# EmbedMaster Player IDs (configured in https://embedmaster.com dashboard):
# - Customer / Default Player : v23rgjijhbwlarnpf1 (Used for all regular viewers & guests)
# - Admin Player              : v2acgdm2adzyn2pr4d (Used when signed in with admin email)
# Note: In Max Cinema, these player IDs are auto-linked in src/lib/api.js

# Optional: Provider API key if using custom authenticated EmbedMaster endpoints
# EMBED_API_KEY=

# ── Google AdSense & Monetization ───────────────────────────────────────────
# Pre-configured in index.html and src/components/AdUnit.jsx
# Publisher ID: ca-pub-1450329989131749

# ── CineScope Backend API ───────────────────────────────────────────────────
# External curated collections, ads, recommendations, and analytics service
VITE_CINESCOPE_API_URL=https://cinescope-api-9ukz.onrender.com

# ── Local Development Admin Mode ────────────────────────────────────────────
# Set to true only in local staging environments to enable the local admin tool
VITE_ADMIN_MODE=false

# ── Supabase (Optional Cloud Database) ──────────────────────────────────────
# Public credentials (browser-safe, restricted by Row Level Security)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Server-only credentials (used by backend Node server if enabled)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SECRET_KEY=your_supabase_service_role_secret_key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

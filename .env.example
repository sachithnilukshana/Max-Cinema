# Keep real values in .env. Never commit that file.
TMDB_API_KEY=your_tmdb_v3_api_key
# The API binds to localhost by default. Set HOST only behind an HTTPS reverse proxy.
# HOST=0.0.0.0

# Optional alternative to TMDB_API_KEY.
# TMDB_READ_ACCESS_TOKEN=your_tmdb_read_access_token

# Configure only a playback provider you are licensed to distribute. This must use HTTPS.
EMBED_BASE=https://your-licensed-provider.example
# Use a short-lived or browser-safe embed token; an iframe provider can see this value.
EMBED_API_KEY=your_provider_key

# Enables the local admin workspace. A real production admin requires server-side auth.
VITE_ADMIN_MODE=false

# Supabase browser configuration. The publishable key may be exposed to the
# browser, but Row Level Security policies must be enabled before deployment.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
